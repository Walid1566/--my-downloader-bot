import logging
import os
import re
import tempfile

from telegram import Update
from telegram.constants import ChatAction
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)
from yt_dlp import YoutubeDL

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

BOT_TOKEN = os.environ.get("BOT_TOKEN")

URL_PATTERN = re.compile(
    r"https?://(?:www\.)?(?:tiktok\.com|vm\.tiktok\.com|instagram\.com)/\S+",
    re.IGNORECASE,
)

MAX_TELEGRAM_FILE_MB = 50  # limit for bots sending via sendVideo


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text(
        "أهلاً بك 👋\n"
        "أرسل لي رابط فيديو من تيك توك أو انستغرام وسأقوم بتنزيله وإرساله لك."
    )


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    text = update.message.text or ""
    match = URL_PATTERN.search(text)

    if not match:
        await update.message.reply_text(
            "من فضلك أرسل رابط صحيح من تيك توك أو انستغرام."
        )
        return

    url = match.group(0)
    await update.message.chat.send_action(ChatAction.UPLOAD_VIDEO)
    status_msg = await update.message.reply_text("جاري التنزيل... ⏳")

    with tempfile.TemporaryDirectory() as tmp_dir:
        output_template = os.path.join(tmp_dir, "%(id)s.%(ext)s")
        ydl_opts = {
            "outtmpl": output_template,
            "format": "mp4/best",
            "quiet": True,
            "no_warnings": True,
            "noplaylist": True,
            "max_filesize": MAX_TELEGRAM_FILE_MB * 1024 * 1024,
        }

        try:
            with YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(url, download=True)
                file_path = ydl.prepare_filename(info)

            if not os.path.exists(file_path):
                await status_msg.edit_text(
                    "تعذر تنزيل الفيديو (قد يكون الحساب خاص أو الرابط غير مدعوم)."
                )
                return

            file_size_mb = os.path.getsize(file_path) / (1024 * 1024)
            if file_size_mb > MAX_TELEGRAM_FILE_MB:
                await status_msg.edit_text(
                    f"حجم الفيديو كبير جداً ({file_size_mb:.1f}MB) لإرساله عبر البوت."
                )
                return

            await status_msg.edit_text("تم التنزيل، جاري الإرسال... 📤")
            with open(file_path, "rb") as video_file:
                await update.message.reply_video(
                    video=video_file,
                    caption=info.get("title", "") or "",
                )
            await status_msg.delete()

        except Exception as exc:  # noqa: BLE001
            logger.exception("Download failed for %s", url)
            await status_msg.edit_text(f"حدث خطأ أثناء التنزيل:\n{exc}")


def main() -> None:
    if not BOT_TOKEN:
        raise RuntimeError("يجب ضبط متغير البيئة BOT_TOKEN قبل التشغيل.")

    application = Application.builder().token(BOT_TOKEN).build()

    application.add_handler(CommandHandler("start", start))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    logger.info("Bot is starting...")
    application.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
